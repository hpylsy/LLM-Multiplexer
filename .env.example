# === Django Core ===
DJANGO_SECRET_KEY=replace-me-with-a-secure-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# === Database ===
POSTGRES_DB=lab_portal
POSTGRES_USER=lab_portal
POSTGRES_PASSWORD=lab_portal_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Locale ===
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# === Dashboard ===
PUBLIC_DASHBOARD_ENABLED=True
PUBLIC_DASHBOARD_MASK_USERNAMES=True

# === CLIProxy Connection ===
CLIPROXY_BASE_URL=http://your-proxy-server:8320
CLIPROXY_MANAGEMENT_BASE_URL=http://127.0.0.1:8317
CLIPROXY_MANAGEMENT_KEY=your-management-key

# === Branding (customize for your team) ===
SITE_TITLE=AI中转站
SITE_SUBTITLE=AI Relay Console
SITE_DESCRIPTION=面向团队成员统一提供大模型中转、调用统计与额度管理服务。
SITE_TEAM_NAME=我的团队
SITE_MOTTO=
SITE_MOTTO_DESCRIPTION=
